{
  "redirects": [
    {
      "source": "/financeiro",
      "destination": "https://financeiro-gift.vercel.app",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/anti-fake-query",
      "destination": "/anti-fake-query/index.html"
    },
    {
      "source": "/anti-fake-query/",
      "destination": "/anti-fake-query/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}